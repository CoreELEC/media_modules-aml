load("//common_drivers:amlogic_utils.bzl", "kernel_select", "ddk_deps_select", "media_modules_cflag")

genrule(
    name = "generate_version_header",
    srcs = [
        "version_control.sh",
        "VERSION",
    ],
    outs = ["drivers/frame_provider/decoder/utils/vdec_version.h"],
    cmd = "mkdir -p $(@D)&& bash $(location version_control.sh) DDK > $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "ddk_extra_cflag",
    outs = ["drivers/include/media_extra.h"],
    cmd = "mkdir -p $(@D) && bash $(location ddk_extra_cflag.sh) '" + media_modules_cflag + "' > $@",
    tools = ["ddk_extra_cflag.sh"],
    visibility = ["//visibility:public"],
)

